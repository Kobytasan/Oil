<%- include('partials/header') %>

<div class="breadcrumbs">
  <a href="/">Головна</a> / <a href="/catalog">Каталог</a> /
  <a href="/catalog?cat=<%= product.category_id %>"><%= product.category_name || 'Каталог' %></a> /
  <span><%= product.name %></span>
</div>

<div class="product-detail">
  <div class="product-detail-visual"><%= product.icon %></div>
  <div class="product-detail-info">
    <h1><%= product.name %></h1>
    <span class="product-cat">Категорія: <%= product.category_name || '—' %></span>
    <p class="product-desc"><%= product.description %></p>

    <div class="price-table">
      <div class="price-row">
        <span>Роздрібна ціна</span>
        <strong><%= Number(product.price_retail) %> грн / <%= product.unit %></strong>
      </div>
      <div class="price-row price-row-opt">
        <span>Оптова ціна (від <%= product.wholesale_min %> <%= product.unit %>)</span>
        <strong><%= Number(product.price_wholesale) %> грн / <%= product.unit %></strong>
      </div>
      <div class="price-row">
        <span>Наявність на складі</span>
        <strong><%= product.stock > 0 ? product.stock + ' ' + product.unit : 'немає' %></strong>
      </div>
    </div>

    <% if (product.stock > 0) { %>
      <form method="POST" action="/cart/add/<%= product.id %>" class="add-form add-form-lg">
        <label>Кількість, <%= product.unit %>:
          <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>">
        </label>
        <input type="hidden" name="back" value="/product/<%= product.id %>">
        <button class="btn btn-primary btn-lg">Додати до кошика</button>
      </form>
    <% } else { %>
      <div class="alert alert-info">Товар тимчасово відсутній на складі.</div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
