<%- include('../partials/header') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-user">
      <div class="admin-avatar"><%= user.name[0] %></div>
      <div>
        <strong><%= user.name %></strong>
        <span><%= user.position %></span>
      </div>
    </div>
    <nav class="admin-nav">
      <a href="/admin">📊 Огляд</a>
      <a href="/admin/orders" class="active">🧾 Замовлення</a>
      <% if (user.role === 'director' || user.role === 'manager') { %><a href="/admin/products">📦 Товари</a><% } %>
      <% if (user.role === 'director') { %><a href="/admin/employees">👥 Працівники</a><% } %>
      <a href="/catalog">🛒 Відкрити сайт</a>
      <a href="/logout">🚪 Вийти</a>
    </nav>
  </aside>

  <div class="admin-content">
    <h1 class="page-title">Замовлення №<%= order.id %></h1>

    <div class="order-card card">
      <div class="order-head">
        <div>
          <span class="status status-<%= order.status %>"><%= order.status %></span>
          <p class="order-date"><%= new Date(order.created_at).toLocaleString('uk-UA') %></p>
        </div>
        <div class="order-total"><%= Number(order.total) %> грн</div>
      </div>

      <table class="table">
        <thead><tr><th>Товар</th><th>К-сть</th><th>Ціна</th><th>Сума</th></tr></thead>
        <tbody>
          <% items.forEach(it => { %>
            <tr>
              <td><%= it.product_name %> <% if (it.wholesale) { %><span class="opt-tag">опт</span><% } %></td>
              <td><%= it.qty %></td>
              <td><%= Number(it.price) %> грн</td>
              <td><%= Number(it.price) * it.qty %> грн</td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="order-meta">
        <div><span>Покупець:</span><strong><%= order.customer_name %></strong></div>
        <div><span>Телефон:</span><strong><%= order.phone %></strong></div>
        <% if (order.company) { %><div><span>Підприємство:</span><strong><%= order.company %></strong></div><% } %>
        <% if (order.city) { %><div><span>Місто:</span><strong><%= order.city %></strong></div><% } %>
        <% if (order.address) { %><div><span>Адреса:</span><strong><%= order.address %></strong></div><% } %>
        <div><span>Доставка:</span><strong><%= order.delivery || '—' %></strong></div>
        <div><span>Оплата:</span><strong><%= order.payment || '—' %></strong></div>
        <% if (order.comment) { %><div><span>Коментар:</span><strong><%= order.comment %></strong></div><% } %>
      </div>

      <div class="status-form">
        <h4>Змінити статус замовлення</h4>
        <form method="POST" action="/admin/orders/<%= order.id %>/status" class="inline-form">
          <input type="hidden" name="back" value="/admin/orders/<%= order.id %>">
          <select name="status">
            <% ['нове', 'підтверджено', 'відправлено', 'виконано', 'скасовано'].forEach(s => { %>
              <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
          <button class="btn btn-primary">Зберегти статус</button>
        </form>
      </div>
    </div>

    <a href="/admin/orders" class="btn btn-outline">← До списку замовлень</a>
  </div>
</div>

<%- include('../partials/footer') %>
